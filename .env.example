# Copy to .env and adjust as needed. Ports here match docker-compose.yml.

REQUEST_ID_HEADER=x-request-id

GATEWAY_PORT=3000
USER_SERVICE_PORT=3001
ORDER_SERVICE_PORT=3002
PAYMENT_SERVICE_PORT=3003

MONITORING_PORT=4001
FAILURE_DETECTION_PORT=4002
RECOVERY_PORT=4003
FAULT_INJECTION_PORT=4004

DASHBOARD_PORT=5173

GATEWAY_URL=http://localhost:3000
USER_SERVICE_URL=http://localhost:3001
ORDER_SERVICE_URL=http://localhost:3002
PAYMENT_SERVICE_URL=http://localhost:3003
MONITORING_URL=http://localhost:4001
FAILURE_DETECTION_URL=http://localhost:4002
RECOVERY_URL=http://localhost:4003
FAULT_INJECTION_URL=http://localhost:4004

DB_USER=capstone
DB_PASSWORD=capstone
DB_NAME=capstone
DATABASE_URL=postgres://capstone:capstone@localhost:5432/capstone
